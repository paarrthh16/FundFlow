# Copy to .env and replace the placeholder values. Never commit .env.
# Read by docker compose (database container) and by Django (backend/config/settings.py).

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (used by compose.yaml and Django) ---
POSTGRES_DB=fundflow
POSTGRES_USER=fundflow
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Frontend dev server (Vite proxies /api to this URL) ---
API_PROXY_TARGET=http://127.0.0.1:8000
